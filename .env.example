# Public runtime config
NUXT_PUBLIC_API_BASE=/api

# ตั้งค่าอีเมลสำหรับแจ้งเตือน (SMTP)
# ผู้รับเริ่มต้น (คั่นด้วยคอมมา) — ใส่ตามที่ร้องขอ
NUXT_MAIL_TO=Apirak.ba@gmail.com,Apirak.ba@outlook.com,Apirak@pointit.co.th
# ผู้ส่ง
NUXT_MAIL_FROM="Todo Notifier <no-reply@example.com>"

# เลือกผู้ให้บริการ SMTP หนึ่งแบบ แล้วเติม USER/PASS ให้ถูกต้อง

# ตัวอย่าง A) Outlook 365 / Microsoft 365
# NUXT_MAIL_HOST=smtp.office365.com
# NUXT_MAIL_PORT=587
# NUXT_MAIL_USER=your_account@yourdomain.com
# NUXT_MAIL_PASS=your_password_or_app_password

# ตัวอย่าง B) Mailtrap Sandbox (สำหรับทดสอบ)
# NUXT_MAIL_HOST=sandbox.smtp.mailtrap.io
# NUXT_MAIL_PORT=2525
# NUXT_MAIL_USER=your_mailtrap_user
# NUXT_MAIL_PASS=your_mailtrap_pass
